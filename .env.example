# ════════════════════════════════════════════════════════════════════════════
#  MusicFlow — Variables de entorno
#  Copia este archivo a .env y completa los valores.
#  NUNCA subas .env a Git. Solo .env.example va al repositorio.
# ════════════════════════════════════════════════════════════════════════════

# ── Flask ────────────────────────────────────────────────────────────────────
FLASK_APP=app:create_app
FLASK_ENV=development
SECRET_KEY=cambia_esto_por_una_clave_muy_larga_y_aleatoria_en_produccion

# ── Base de datos ────────────────────────────────────────────────────────────
POSTGRES_DB=musicflow
POSTGRES_USER=musicflow
POSTGRES_PASSWORD=musicflow_secret
DATABASE_URL=postgresql://musicflow:musicflow_secret@db:5432/musicflow

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── JWT (autenticación) ──────────────────────────────────────────────────────
JWT_SECRET_KEY=cambia_esto_tambien_por_algo_muy_secreto
JWT_ACCESS_TOKEN_EXPIRES=3600        # 1 hora en segundos
JWT_REFRESH_TOKEN_EXPIRES=2592000    # 30 días en segundos

# ── Admin inicial (se crea automáticamente al iniciar por primera vez) ────────
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123

# ── pgAdmin ──────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@gmail.com
PGADMIN_PASSWORD=admin123

# ── Descarga ─────────────────────────────────────────────────────────────────
MAX_SEARCH_RESULTS=15
DOWNLOAD_CONCURRENCY=3               # Workers de descarga simultáneos
DOWNLOAD_RATE_LIMIT=10/m             # Máximo 10 descargas por minuto por worker

# ── Caché ────────────────────────────────────────────────────────────────────
SEARCH_CACHE_TTL=300                 # Segundos que vive una búsqueda en caché (5 min)

# ── Servidor ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5001
